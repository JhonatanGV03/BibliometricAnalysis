@INPROCEEDINGS{11349044,
  author={Vasveliya, Pravin Kumar and Barman, Nabarun and Arora, Manish and Biswas, Abhijit},
  booktitle={2025 International Conference on Robotics and Mechatronics (ICRM)}, 
  title={A Haptics Based Programming Learning Device Accessible for the Visually Challenged}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={There exist very few tools for teaching visually challenged kids computer programming. The current systems primarily use exploration of different algorithms to execute sequential tasks for the development of computational thinking and use audio output of a computation system for user interaction. For the young visually challenged kids, the development of computational thinking with multimodal interaction, including haptics, is more effective. This paper describes the functioning and usage of a tangible computation device consisting of different types of hardware-programmable (configurable) blocks or keys offering distinctive haptic perception when gripped or manipulated. These programmable keys could be inserted in sequential slots of a hub or console, acting as a CPU for arithmetic and logical instruction processing of a customized computer integrated with its specialized input device. The keys provide a sequence of instructions with data (operand) based on their own configurations. The sequence of the instructions given to the computer is encoded in terms of the order of the slots where the keys are inserted. The hub processes the instruction sequence, decodes the instruction and extracts the data associated with each instruction. The compiled instructions can be executed and debugged using a vibrotactile display. Also, a standard smartphone or tablet paired with it can act as the output device. For this, customized vibration patterns are generated based on the touch position sensed from the screen. This system is also useful and attractive for training any kid in general, hence it promotes inclusivity among the kids, normal and visually challenged.},
  keywords={Training;Performance evaluation;Vibrations;Visualization;Input devices;Programming;Haptic interfaces;Usability;Standards;Robots;Computational thinking;Visual Rehabilitation;Vibrotactile display;Programming training;Gamification;Computer interaction},
  doi={10.1109/ICRM66809.2025.11349044},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{9429100,
  author={Slomp, Edésio Marcos and Schuhmacher, Elcio and Schuhmacher, Vera Rejane Niedsberg},
  booktitle={2021 IEEE World Conference on Engineering Education (EDUNINE)}, 
  title={Using computacional thinking as a strategy for the development of reasoning and logic in students about the theme of ecology during the pandemic}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={This article reports the development of reasoning and logic using Computational Thinking skills about content in Ecology, using as active strategy, contextualized practical activities for the Forest Engineering, Biology, Agronomic Engineering and Geography courses at the Regional University of Blumenau during the pandemic period of COVID-19. Computational thinking has been increasingly encouraged, not only for those who wish to become computer scientists, but also to develop other important skills that are used to solve problems, using a combination of critical thinking and fundamentals of computing. The research used was qualitative of the phenomenological type. In the analysis, the teachers involved concluded that to solve a problem, even if it is Ecology, it is not necessary to use a computer to process the algorithm to find the solution, a student can create an algorithm and process it and find the answer.},
  keywords={Geography;COVID-19;Pandemics;Conferences;Forestry;Ecology;Cognition;Computational Thinking;Active Strategy;Ecology},
  doi={10.1109/EDUNINE51952.2021.9429100},
  ISSN={},
