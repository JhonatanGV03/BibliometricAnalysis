author = {Xifeng Liao},
keywords = {GenAI, Student Learning, Development, Visualize, CiteSpace},
abstract = {ABSTRACT
The ubiquitous use of generative artificial intelligence (GenAI) technology has led to an explosion of scholarly interest in investigating the application of this emerging technology to supporting student learning and development. To gain an overarching view of the existing scientific literature and identify this field’s areas of intense interest and future research trends, this systematic review, conducted with the assistance of the visualization software, aims to answer five research questions. This review identifies the main contributors to the relevant research, analyzes the status quo of GenAI technology in education, synthesizes the benefits and challenges of GenAI integration, and proposes interventions for future applications. The study proposes that a closer collaboration network in three dimensions—pedagogical use, learning integration, and administrative operation—may contribute to tackling negative impacts on student development and enhance effective learning.}
}
@article{DASTANE2024473,
title = {The trajectory of artificial intelligence for competency-based personalised learning: past, present and future},
journal = {International Journal of Information and Learning Technology},
volume = {41},
number = {5},
pages = {473-489},
year = {2024},
issn = {2056-4880},
doi = {https://doi.org/10.1108/IJILT-07-2024-0162},
url = {https://www.sciencedirect.com/science/article/pii/S2056488024000088},
author = {Omkar Dastane and Jason Turner and Alan Nankervis},
keywords = {Artificial intelligence, Competency-based learning, Personalised learning, Bibliometric analysis, Science mapping, Literature review},
abstract = {Purpose
The study aims to reflect on past research, uncover current trends and propose a future research agenda in the field of artificial intelligence (AI) for competency-based personalised learning.
Design/methodology/approach
The study followed the SPAR-4-SLR protocol to retrieve 855 articles related to the field indexed in the Scopus database. Performance analysis, network analysis and science mapping were then performed using VOSviewer and the Biblioshiny app.
Findings
The analysis identified nine clusters of intellectual structure (healthcare, competencies, learning systems, digital transformation, AI literacy, computer-aided education, AI ethics, e-learning and active learning) and twelve themes (including motor, basic, emerging and niche).
Originality/value
Following an extensive review of the literature, this would appear to be the first study to provide a panoramic view of AI for competency-based personalised learning based on the Scopus database. The core gaps in the current literature have been identified and the corresponding future agenda will be instrumental in shaping future research directions in the field.}
}
@article{DIMAKIS2025273,
title = {Static, spherically symmetric solutions in f(Q)-gravity and in nonmetricity scalar-tensor theory},
journal = {Journal of High Energy Astrophysics},
volume = {45},
pages = {273-289},
year = {2025},
issn = {2214-4048},
doi = {https://doi.org/10.1016/j.jheap.2024.12.011},
url = {https://www.sciencedirect.com/science/article/pii/S2214404824001526},
author = {Nikolaos Dimakis and Petros A. Terzis and Andronikos Paliathanasis and Theodosios Christodoulakis},
keywords = {-gravity, Black holes, Exact solutions, Nonmetricity scalar-tensor},
abstract = {We solve the gravitational field equations for a static, spherically symmetric spacetime within the framework of the symmetric teleparallel theory of gravity. Specifically, we derive new solutions within the context of power-law f(Q) gravity and the nonmetricity scalar-tensor theory. For the connection in the non-coincidence gauge, we present the point-like Lagrangian that describes the employed field equations. Furthermore, we construct two conservation laws, and for different values of these conserved quantities, we analytically solve the gravitational field equations. New solutions are obtained, we investigate their physical properties and their general relativistic limit. Finally, we discuss the algebraic properties for the derived spacetimes.}
}
@article{CAMPS2026103124,
