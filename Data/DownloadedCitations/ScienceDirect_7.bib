}
@incollection{ERSTAD2023245,
title = {Educational assessment of 21st century skills—novel initiatives, yet a lack of systemic transformation},
editor = {Robert J Tierney and Fazal Rizvi and Kadriye Ercikan},
booktitle = {International Encyclopedia of Education (Fourth Edition)},
publisher = {Elsevier},
edition = {Fourth Edition},
address = {Oxford},
pages = {245-255},
year = {2023},
isbn = {978-0-12-818629-9},
doi = {https://doi.org/10.1016/B978-0-12-818630-5.09038-2},
url = {https://www.sciencedirect.com/science/article/pii/B9780128186305090382},
author = {Ola Erstad and Fazilat Siddiq},
keywords = {Assessment, 21st century skills, Curriculum development, Collaborative problem solving, Digital literacy},
abstract = {Our aim is to discuss critical issues related to educational assessment in contemporary societies, especially of so-called 21st century skills. We introduce some key definitions of 21st century skills, outline international initiatives dedicated to advancing them, and present two examples of national curricular developments emphasizing and integrating these. Next, we present some examples of projects illustrating the interrelationship between assessment, education and technological development. Last, we introduce some perspectives on the assessment and transformation of education that point toward opportunities and pitfalls for the future. Our analysis shows that while there are a number of ongoing initiatives dedicated to developing instruments and curricula for assessment of 21st century skills, there are also fundamental challenges for the development of relevant assessments on a systemic level and for transforming practices related to 21st century skills more broadly. The lack of representation from several parts of the world, in international assessment initiatives on 21st century skills, is also striking. By taking a meta-perspective, we identify evolving themes within this field and provide a critical perspective on these developments. We conclude there are a number of opportunities and pitfalls for creating good synergies between 21st century skills in curricula and practices, as well as for developing assessment strategies.}
}
@article{DING2026105553,
title = {The paradox of instrumental visibility: A narrative inquiry into epistemic injustice in a STEM-dominated faculty},
journal = {Teaching and Teacher Education},
volume = {177},
pages = {105553},
year = {2026},
issn = {0742-051X},
doi = {https://doi.org/10.1016/j.tate.2026.105553},
url = {https://www.sciencedirect.com/science/article/pii/S0742051X26001745},
author = {Jihong Ding and Huazhong Liu and Shuqin Cao and Yonggu Wang},
keywords = {Academic identity, Narrative inquiry, Epistemic injustice, Interdisciplinary marginalization, Resilience, STEM-dominated evaluation},
abstract = {This narrative inquiry illuminates identity disruption experienced by an educational technology scholar relocating from an education faculty to a STEM-dominated department in China. Situated within STEM-dominated evaluation regimes, the study identifies the paradox of instrumental visibility—a condition where a scholar's expertise is selectively mobilized for institutional prestige yet systemically devalued in formal evaluation and resource allocation. Framed by epistemic injustice and identity agency, the narrative traces a trajectory of disciplinary decentering, affective resistance, and relational reconstruction. Drawing on reflexive journals and institutional documents, the findings reveal how the scholar's pedagogical research was rendered institutionally illegible despite established achievements. Conversely, relational practices—including cross-institutional collaboration and international dialogue—functioned as micro-resistance, sustaining professional coherence under epistemic marginalization. By foregrounding the affective and structural dynamics of interdisciplinary mobility, this study contributes to critical debates on academic identity, epistemic justice, and knowledge governance in contemporary higher education.}
}
@article{HONTELEZ2025103233,
title = {The impact of the PEPFAR funding freeze on HIV deaths and infections: a mathematical modelling study of seven countries in sub-Saharan Africa},
journal = {eClinicalMedicine},
volume = {83},
pages = {103233},
year = {2025},
issn = {2589-5370},
doi = {https://doi.org/10.1016/j.eclinm.2025.103233},
url = {https://www.sciencedirect.com/science/article/pii/S2589537025001658},
author = {Jan A.C. Hontelez and Hannah Goymann and Yemane Berhane and Parinita Bhattacharjee and Jacob Bor and Sungai T. Chabata and Frances Cowan and Joshua Kimani and Justin Knox and Wezzie S. Lora and Cynthia Lungu and Jennifer Manne-Goehler and Joy Mauti and Mosa Moshabela and Rose M. Mpembeni and Mwanza {Wa Mwanza} and Thumbi Ndung'u and Evans Omondi and Sam Phiri and Mark Siedner and Frank C. Tanser and Sake J. {de Vlas} and Till W. Bärnighausen},
keywords = {HIV, PEPFAR, President's emergency plan for AIDS relief, Funding freeze, Executive order, HIV deaths, HIV incidence, HIV infections, Mathematical modeling, STDSIM, Africa, sub-Saharan Africa, Impact, ART, HIV treatment, Treatment interruption, Antiretroviral therapy, Model, Individual based model},
abstract = {Summary
Background
On January 24, 2025, the United States government issued an executive order to freeze all foreign aid programs, including The President's Emergency Plan for AIDS Relief (PEPFAR), for 90 days. A limited waiver option became available, but its implementation remains incomplete. We estimated the impact of these policy changes on HIV deaths and new infections in seven sub-Saharan African (SSA) countries—Ethiopia, Kenya, Malawi, South Africa, Tanzania, Zambia, and Zimbabwe –, which together account for about half of all people living with HIV in SSA.
Methods
We used STDSIM, an established individual-based simulation model, and previously published quantifications for the seven countries. We predicted changes in HIV deaths and new infections over the period 2025–2030 for four scenarios: (1) Executive order—proportional, where treatment disruption was proportional to the country-specific PEPFAR's share of total HIV funding; (2) Executive order—realistic, assuming near-total system collapse due to program dependencies; and (3–4) Waiver scenarios where treatment was resumed after 4 or after 8 weeks. Resumptions of programs accounted for delays due to organizational and logistical challenges.
Findings
A 90-day funding freeze would result in 60 thousand [95% UI: 49–71 thousand] excess HIV deaths for the Executive order—proportional scenario. This number would increase to 74 thousand excess HIV deaths [95% UI: 63–89 thousand] for the Executive order—realistic scenario. Under a 4-week and 8-week waiver scenario, projected excess HIV deaths ranged between 21 thousand [95% UI: 15–28 thousand] and 28 thousand [95% UI: 22–36 thousand] respectively. Excess new infections ranged between 35 and 103 thousand for the different scenarios.
Interpretation
The sudden cessation of PEPFAR funding likely results in tens of thousands of HIV deaths and new infections. These losses of life and health should compel the United States government to rapidly and fully re-instate one of the most successful health programs in history.
Funding
None.}
}
@article{LIU2025108325,
title = {Can digital product innovation enhance corporate market competitiveness?},
