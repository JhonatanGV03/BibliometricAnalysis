@INPROCEEDINGS{9453929,
  author={Ye, Jiachu and Lai, Xiaoyan and Wong, Gary K.W.},
  booktitle={2021 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={The influence of students’ computer science learning experience on their perception of computational thinking}, 
  year={2021},
  volume={},
  number={},
  pages={1495-1496},
  abstract={This systematic review aims to explore how students' CS learning experience influences their perception of computational thinking. We identified 21 publications in SCOPUS and coded them for comparison and synthesis. Through a meta-analysis, we found a medium effect size (g =0.656; p<; 0.001) supporting the influence of CS learning on students' change of perception of CT. Through qualitative synthesis, results show that CS learning experience influences perception of CT in terms of self-efficacy, behavioral & emotional engagement, and awareness of careers. Findings provide insights to facilitate CT education strategies and promote educational equity in the STEM field.},
  keywords={Computer science;Systematics;Engineering profession;Conferences;Engineering education;computational thinking;perception;CS education},
  doi={10.1109/EDUCON46332.2021.9453929},
  ISSN={2165-9567},
  month={April},}
@INPROCEEDINGS{11340251,
  author={Teran, Hector and Barrera, Alejandro Corrales and Leal, Jimmy Garcia and Cortez, Laura Ocampo and Vasquez, Laura and Peñata, Luis Perez and Coba, Esteban Espitia},
  booktitle={2025 IEEE Colombian Caribbean Conference (C3)}, 
  title={Unplugged Activities to Support Computational Thinking in Youth from Low-Income Backgrounds}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Computational Thinking (CT) has emerged as a critical skill for addressing complex problems across multiple disciplines in the digital era. However, students from low-income backgrounds often face limited access to highquality computer science education, which exacerbates the digital divide. To address this challenge, unplugged activities offer a practical and inclusive approach to introducing CT concepts without requiring access to computers or the Internet. This study presents a contextualized implementation framework based on a cascading learning model: university students trained high school seniors, who, in turn, facilitated unplugged CT activities for primary school students. The initiative was applied in selected educational contexts with limited technological infrastructure. Preliminary qualitative observations indicate positive engagement and improved understanding of CT-related skills among participants. While comprehensive quantitative analyses are still ongoing, initial results suggest that unplugged activities can effectively complement efforts to reduce educational inequities. Future research will include the integration of formal assessment instruments to evaluate learning gains more robustly.},
  keywords={Leadership;Humanities;Statistical analysis;Computational modeling;Instruments;Organizations;Computer science education;Teamwork;Digital divide;Problem-solving;CS Unplugged;Computational Thinking;Educational Equity;Cascading Learning Model},
  doi={10.1109/C366505.2025.11340251},
  ISSN={},
  month={Sep.},}
@INPROCEEDINGS{11460247,
  author={Lee, Claire and Park, Jiyoon and Shin, Catherine},
  booktitle={2025 IEEE Integrated STEM Education Conference (ISEC)}, 
  title={The Gap Between Computational Thinking and Coding, and How to Bridge it}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Learning a foreign language usually involves mastering words and grammar to understand sentence patterns. In contrast, coding languages have fewer keywords and simpler grammar, yet they allow for diverse solutions through combinations. This complexity often leads to uncertainty about which syntax to apply in specific situations during problem-solving, making coding challenging. Computational Thinking (CT) aims to bridge this gap by suggesting when to use certain syntax, but Wing's CT concept focuses on human problem-solving, not aligning directly with coding. Meanwhile, Scratch's CT approach is effective for teaching basic computational concepts but lacks a robust theoretical framework for problem solving.This paper proposes a hybrid method combining these strengths: using block coding like Scratch for foundational learning, and applying Wing’s CT from a computer perspective for problem-solving. It showcases a developed website aimed at implementing this educational strategy. The site (https://block4py.org) is publicly available and aims to assist beginners in coding.},
  keywords={Protocols;HTTP;Learning (artificial intelligence);Artificial intelligence;Learning systems;Computers;Python;Computer languages;Computers and information processing;Public domain software;Computational Thinking;Block coding;Hybrid method},
  doi={10.1109/ISEC64801.2025.11460247},
