@INPROCEEDINGS{11476467,
  author={Kimura, Isabel Miyuki and Queiruga, Claudia Alejandra and Díaz, Francisco Javier},
  booktitle={2025 IEEE CHILEAN Conference on Electrical, Electronics Engineering, Information and Communication Technologies (CHILECON)}, 
  title={Pedagogical Experience in AI Teaching for Technical High Schools: a Regional Approach From UNLP}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This article presents an experience of teaching Artificial Intelligence in the technological training of technical high school students specializing in “Professional and Personal Computing” and “Programming” in the province of Buenos Aires, Argentina, developed in a university extension project at the National University of La Plata. The conceptual framework of this work draws on the ideas and practices of the university extension programs of Argentina's national universities, the scientific and technological training provided in technical high education, and approaches to teaching computer science in schools, specifically the contributions of “computational thinking 2.0 ” and current revisions of its concepts and practices in relation to emerging technologies, including machine learning. Workshops were held that combined content on machine learning, deep learning, and ethical aspects, using accessible and free tools such as Google Teachable Machine and MIT App Inventor. Students built and trained supervised learning models that they integrated into mobile applications. The evaluation of the workshops showed that students recognize AI in everyday applications and demonstrate a high level of interest in practical activities, particularly those involving real data. The importance of producing contextualized data to enrich teaching and strengthen technical skills and crosscutting abilities such as creativity and critical thinking is highlighted. Initial results support the pedagogical relevance of integrating AI knowledge into technical high school from a local and regional perspective, promoting critical, ethical, and socially engaged literacy.},
  keywords={Radio broadcasting;Frequency modulation;Internet;Videos;Communications technology;Communication systems;Computer networks;Modulation;Radio broadcasting;Frequency modulation;Artificial Intelligence;Machine Learning;Deep Learning;Technical High Education;University Extension},
  doi={10.1109/CHILECON66915.2025.11476467},
  ISSN={2832-1537},
  month={Oct},}
@INPROCEEDINGS{11381105,
  author={Yuliana, Vena and Mariyana, Rita and Romadona, Nur Faizah and Agustin, Mubiar},
  booktitle={2025 International Workshop on Artificial Intelligence and Education (WAIE)}, 
  title={The Application of Artificial Intelligence Technology in Early Childhood Numeracy: Systematic Literature Review}, 
  year={2025},
  volume={},
  number={},
  pages={212-216},
  abstract={Numeracy Artificial Intelligence (AI) offers personalized, adaptive, and interactive approaches to early childhood numeracy learning. Numeracy which encompasses understanding numbers, patterns, shapes, and problem-solving skills represents a critical aspect of children’s cognitive development. This study systematically reviews the application of AI in numeracy learning through 10 relevant articles published between 2020 and 2025. The findings reveal that AI implemented through mobile applications, educational robots, and gamification effectively enhances children’s interest, comprehension, and engagement, while also supporting early detection of learning difficulties and the development of computational thinking. These results underscore the potential of AI in fostering early numeracy and advancing the stages of mathematics learning for young children.},
  keywords={Technological innovation;Shape;Learning (artificial intelligence);Mathematics;Real-time systems;Mobile applications;Problem-solving;Artificial intelligence;Systematic literature review;Resilience;Numeracy;Artificial Intelligence (AI);Early Childhood},
  doi={10.1109/WAIE67422.2025.11381105},
  ISSN={},
  month={Sep.},}
@INPROCEEDINGS{10607286,
  author={Chen, Chiung-Hui},
  booktitle={2024 9th International Conference on Big Data Analytics (ICBDA)}, 
  title={Web3.0 Generative Art- A Co-Creation System in Environmental Sustainability Concept Form}, 
  year={2024},
  volume={},
  number={},
  pages={264-269},
  abstract={In 2021, the first year of Metaverse, Web3.0 ecosystems emerged as a result of the Internet's de-centralized evolution. In the Web3.0 space, there has been a very active advancement of the generative art non-fungible token, which is a special asset stored on a blockchain that allows creators to buy and sell assets and verify ownership. In other words, as it reconstructs the interpersonal relationship, the generative art non-fungible token must carry cultural values to be meaningful, and waiting to observe artificial intelligence generative art in the future requires a new mindset and posture. Design thinking is a design-based approach to solve today's complex problems. This study thus addresses the new Web3.0 ecosystem and introduces environmental sustain ability issues and computational thinking in the form of generative art to discuss the possibilities of future design thinking. By linking with social information, this study also creates an intersection with heterogeneous knowledge and stimulates a new thinking pattern that is different from previous ones. This project of design and research in the Metaverse virtual environment is still a novel topic. Reviewing past literature indicates that relevant papers are very scarce, and more resources are urgently needed for research in this field.},
  keywords={Art;Metaverse;Ecosystems;Green products;Big Data;Internet;Nonfungible tokens;blockchain;Web3.0;generative art;collaboration;sustainability},
  doi={10.1109/ICBDA61153.2024.10607286},
  ISSN={},
  month={March},}
@INPROCEEDINGS{9974671,
  author={Havlaskova, T. and Javorcik, T.},
  booktitle={2022 20th International Conference on Emerging eLearning Technologies and Applications (ICETA)}, 
  title={Future Lower Primary School Teachers Taking an Online Algorithmization and Programming Course and Self-Assessing their Performance}, 
  year={2022},
  volume={},
  number={},
  pages={202-208},
  abstract={Computational thinking, problem-solving and the ability to apply knowledge; these and a plethora of other skills are essential for success in both personal and professional life. In order to be able to develop those skills in their students, the teachers themselves need to possess them. This paper focuses on female future lower primary school teachers who, in the middle of the Covid-19 pandemic, took an online course on algorithmization and programming, having little or no prior knowledge and skills. The completion rate depended not only on the students' motivation and willingness to learn, but mainly on the content and structure of the course, which was completely modified and made into an online course. The results were more than surprising. The students were able to complete the activities included in the course. Moreover, those activities inspired them to create their own activities, which they may be able to use in their future classes.},
  keywords={Training;COVID-19;Electronic learning;Pandemics;Toy manufacturing industry;Tutorials;Problem-solving},
  doi={10.1109/ICETA57911.2022.9974671},
  ISSN={},
  month={Oct},}
@INPROCEEDINGS{9201719,
  author={Wei, Dongmei and Wang, Xiuhua and Wang, Ying},
  booktitle={2020 15th International Conference on Computer Science & Education (ICCSE)}, 
  title={Exploration and Practice of Python Programming teaching model Based on MBO}, 
  year={2020},
  volume={},
  number={},
  pages={561-567},
  abstract={Cultivating students' innovative ability has been playing an important role in the process of program design courses in Colleges and Universities. This paper focuses on presenting practical experience of the programming and designing patterns in teaching Python programming. Combining MBO (Management By Objective) with teaching, an optimized teaching model of Python Programming based on MBO. The model consists of four parts: Knowledge objectives, Technology ability objectives, Thinking Developed objectives, extended ability objectives. Following the four main goals, this paper introduces relevant teaching practices based on each objective. Applying the model , the quality of planned teaching and learning can be improved. Because setting clear goals could make it easy to formulate plans, tasks, teaching contents, track learning effects and test learning consequences. According to the model, the course teaching practice will highlight the importance of teaching Program concretely and effectively. Most significantly, teachers could train students to gradually develop computational thinking and apply it in subsequent courses.},
  keywords={Education;Python;Programming profession;Task analysis;Tools;Knowledge engineering;Programming Teaching;Management by Objective;Python Ecosystem;Computational Mind},
  doi={10.1109/ICCSE49874.2020.9201719},
  ISSN={2473-9464},
  month={Aug},}
@INBOOK{11052321,
  author={Carius, Ana Carolina and Baldner, Felipe de Oliveira},
  booktitle={Intelligent Educational Robots: Toward Personalized Learning Environments}, 
  title={Maker movement and educational robotics in Brazil: from legislation to emerging practices in the school environment}, 
  year={2025},
  volume={},
  number={},
  pages={45-58},
  abstract={This work has, as its object of study, the implementation of the new high school (or secondary education) in Brazil, with a focus on the insertion of computational robotics, programming, and maker activities in each of the 26 states of the federation. As a general objective, we intend to evaluate the influence of the maker movement in the STEM area in Brazilian high schools, with a focus on the development of computational thinking in students, based on approaches in computational robotics. A mixed qualitative and quantitative study was carried out where, from a qualitative point of view, research was conducted on the state resolutions that guided the choice of the so-called learning paths and their implications in computational robotics. From a quantitative perspective, a study is presented based on data from the 2023 School Census, which aggregates all Brazilian schools. It was then verified the presence or absence of adequate infrastructure for the installation and operation of activities involving computational robotics in Brazilian schools. It is concluded that there are innovative initiatives aimed at expanding activities involving computational robotics at the high school level in Brazilian schools, although there is still a lack of significant investment in school infrastructure to accommodate this new moment in education in technology and innovation in Brazil.},
  keywords={},
  doi={},
  ISSN={},
  publisher={De Gruyter},
  isbn={9783111352961},
  url={https://ieeexplore-ieee-org.crai.referencistas.com/document/11052321},}
@ARTICLE{11408841,
  author={Bergman, Abigail J. and Mikulski, Claire and Manseau, Annick and Migon, Sofia and Wilder, Julia and Searle, Kristin and Hira, Avneet},
  journal={IEEE Revista Iberoamericana de Tecnologias del Aprendizaje}, 
  title={Coding Beyond the Screen: Integrating the Coding as Another Language Curriculum With Physical Computing}, 
  year={2026},
  volume={21},
  number={},
  pages={91-96},
  abstract={The Coding as Another Language (CAL) curriculum offers a means for young children to develop digital coding skills, which is a form of literacy development. The work presented in this paper extends this idea to the domain of physical computing, positing that it leverage the same powerful ideas of computational thinking. Furthermore, this hands-on, often screen-free domain provides an additional venue that invites young children to develop operational, cultural, and critical literacies in developmentally appropriate ways. To illustrate these ideas, this paper describes three prototypes of early childhood physical computing technologies and relevant curricular activities based on CAL. These cases highlight young children’s growing technological fluency as they transferred and deepened their new knowledge through engagement with various physical materials. The materials used to craft tangible artifacts serve as a medium for developing technical skills, expressing ideas, fostering shared values, and questioning established processes. To this end, authors noted how the CAL curriculum can place physical computing in conversation with other technical, experiential, and deeply humanistic pursuits.},
  keywords={Encoding;Education;Computed tomography;Prototypes;Light emitting diodes;Affordances;Wiring;Videos;Translation;STEM;Computer science education;curriculum development;engineering education;STEM},
  doi={10.1109/RITA.2026.3667447},
  ISSN={1932-8540},
  month={},}
@INPROCEEDINGS{11380416,
  author={Bopitiya, S. R. and Sumanasekara, P. D. M. and Tennakoon, T. M. T. C. and Kodagoda, N.},
  booktitle={2025 5th International Conference on Educational Technology (ICET)}, 
  title={Blocky-Based Programming Environment for Developing Cross-Platform Mobile Applications}, 
  year={2025},
  volume={},
  number={},
  pages={222-227},
  abstract={This paper introduces MiniBlocks, a child-friendly blocky-based programming environment focused on designing and deploying cross-platform mobile applications. MiniBlocks distinguishes itself through three core innovations: (1) a child-friendly UI designer featuring accessible widgets tailored to young learners; (2) an integrated debugger within the logic block designer, offering real-time feedback and step-by-step execution; and (3) cross-platform compilation and deployment pipelines for generating native Android and iOS packages. The paper begins with a literature review of 18 relevant studies and industry reports (2018–2024) on no-code and block-based platforms in K–12 education. Results show that MiniBlocks increases engagement and eases the learning curve compared to existing tools while filling a major gap in cross-platform application generation. Building on these foundations, the study further positions MiniBlocks as an end-to-end learning ecosystem that bridges early computational thinking pedagogy with real-world software engineering practices. We present a mixed-methods evaluation involving 72 participants aged 7–15 and 15 instructors, in which learners produced fully deployable apps that ran on both Android and iOS devices within a single 90-minute classroom session, an outcome unattainable with comparator platforms such as Scratch, MIT App Inventor, or Glide. MiniBlocks’ serverless build pipeline, implemented through GitHub Actions and containerized Flutter toolchains also achieved an average 38 % decrease in compilation latency compared with conventional CI/CD workflows. These findings underscore MiniBlocks’ potential not only as a teaching aid but as a scalable blueprint for future no-code solutions that aspire to deliver authentic, device-ready outcomes for novice programmers. By uniting child-centric design principles with industrial-grade deployment architecture, MiniBlocks charts a compelling path toward democratizing mobile-app creation for the next generation of digital innovators.},
  keywords={Bridges;Visualization;Pipelines;Ecosystems;Educational technology;Mobile applications;Logic;Programming profession;Next generation networking;Programming environments;Block-based programming;Children’s programming environment;Cross-platform mobile app deployment;K–12 education;No-code platforms;Visual programming},
  doi={10.1109/ICET67421.2025.11380416},
  ISSN={},
  month={Sep.},}
@INPROCEEDINGS{10894719,
  author={Gulácsi, Ádám and Dienes-Gulácsi, Nikolett and Tóth, Róbert},
  booktitle={2024 IEEE 15th International Conference on Cognitive Infocommunications (CogInfoCom)}, 
  title={Supporting Learning Processes using Emerging Technologies and Gamification}, 
  year={2024},
  volume={},
  number={},
  pages={000197-000202},
  abstract={In the last decades, our society has become massively technology-dependent. Various solutions, such as Augmented Reality (AR) and Virtual Reality (VR), can be involved in learning processes to enhance the students’ experience, while elements of gamification can be implemented to engage and keep the users motivated. In this paper, we summarize current research and introduce our relevant development projects about students’ algorithmic, programming, and visual skills. One of the tangible results of our research is an in-house serious game development project. SpreGosts was designed and implemented to develop the essential computational thinking skills of students in a spreadsheet-like virtual environment. Parallel, the viSkillz research team has already published open-source packages and pilot applications, providing essential assets to construct classic spatial ability tests.},
  keywords={Visualization;Video games;Virtual environments;Prototypes;Games;Gain measurement;Syntactics;Software;Problem-solving;Augmented reality},
  doi={10.1109/CogInfoCom63007.2024.10894719},
  ISSN={2473-5671},
  month={Sep.},}
@INPROCEEDINGS{11120412,
  author={Zhang, Junna and Sun, Yulin and Duan, Li and Liu, Hui and Liu, Chunhong and Zhang, Aili and Yuan, Peiyan},
  booktitle={2025 IEEE International Conference on Software Services Engineering (SSE)}, 
  title={A Practical Teaching Model of Software Engineering Courses for Artificial Intelligence Literacy Cultivation in Pre-Service Teachers}, 
  year={2025},
  volume={},
  number={},
  pages={211-218},
  abstract={This study aims to guide pre-service teachers in effectively utilizing Generative Artificial Intelligence (GAI) tools to enhance their Artificial Intelligence (AI) literacy. By ana-lyzing the impact of GAI on the AI literacy of pre-service teachers, this study proposes a “teacher-student-machine” triadic interactive teaching model based on self-organized learning and deep empowerment through GAI. Using an experimental class in a software engineering course as a case study, we construct an end-to-end experimental environment for the project-driven teaching lifecycle, covering requirement analysis, system design, development and implementation, as well as software testing and maintenance phases. GAI is used to support the completion of experimental tasks while fostering pre-service teachers' AI literacy in five core competencies: data literacy, digital communication and collaboration, critical thinking, computational thinking, and ethical literacy. The study demonstrates that this model effectively improves the AI literacy of pre-service teachers, provides a reference for innovating software engineering practice teaching, and offers a useful framework for the application of GAI in education.},
  keywords={Software testing;Generative AI;Computational modeling;Education;Learning (artificial intelligence);Software;Maintenance;Artificial intelligence;System analysis and design;Software engineering;artificial intelligence literacy;pre-service teachers;Self-Organization Learning Theory;generative artificial in-telligence;software engineering course},
  doi={10.1109/SSE67621.2025.00034},
  ISSN={},
  month={July},}