@INPROCEEDINGS{11413520,
  author={Zhao, Jingjie and Lei, Yu and Yi, Baolin},
  booktitle={2025 International Conference on Educational Technology Management (ICETM)}, 
  title={Exploring the Influencing Factors and Mechanisms of Computational Thinking in GAI-Supported Human-Computer Collaborative Learning}, 
  year={2025},
  volume={},
  number={},
  pages={399-404},
  abstract={In the age of artificial intelligence, computational thinking (CT) has become an essential skill for new-age professionals, making the study of its influencing mechanisms crucial. While existing research points to individual interest, self-efficacy, and instructional support as key factors in students' CT, there's a lack of systematic investigation into how these multiple factors interact within a human-computer collaborative environment supported by Generative AI (GAI). To address this gap, this study systematically explores the key factors and their mechanisms influencing students' CT by analyzing data from a survey of 308 university students using structural equation modeling. The findings reveal that technological support serves as a crucial mediator between individual preference and CT. Additionally, self-efficacy and cognitive load significantly mediate the relationships between technological support, instructional support, and human-computer interaction, as well as CT. This research establishes a multi-factor, multi-path model for the influencing mechanisms of CT, which not only offers a new framework for understanding its development in complex human-computer collaboration settings but also provides valuable guidance for future GAI pedagogical practices.},
  keywords={Surveys;Human computer interaction;Systematics;Generative AI;Federated learning;Collaboration;Educational technology;Mathematical models;Data models;Load modeling;computational thinking;Generative AI;human-computer collaborative;distributed cognition},
  doi={10.1109/ICETM67477.2025.11413520},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11328630,
  author={Tagare, Deepti and Chaudhary, Divya},
  booktitle={2025 IEEE Frontiers in Education Conference (FIE)}, 
  title={WIP: Do Your Students Learn Multiple Programming Languages? How Do Computational Thinking Skills Help Them?}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This work-in-progress research paper investigates how computational thinking skills (CTS) affect computing students' ability to learn multiple programming languages to thrive in their career. Computing degree program curricula include courses that require students to learn and use different programming languages such as Python, Java, JavaScript, C, C++, and SQL for their assignments and projects. Each language has different rules, syntaxes and use cases, making it hard for the students to learn and switch between them. This paper explores whether CTS like problem solving, decomposition, algorithmic thinking, and pattern recognition can help graduate students learn more than one programming language. This exploratory survey-based research study included multiple-choice and open-ended questions as well as a CTS scale. Our preliminary findings from a sample of 37 students show that students with higher CTS find it easier to learn a second programming language and convert code from one language to another. Students reported that they use algorithmic thinking, problem solving, abstraction, and decomposition often while programming. We suggest teaching CTS skills along with basic programming topics to improve students' learning experience and help them become lifelong learners. Pedagogical strategies such as pair programming and modelling can help instructors facilitate the learning of CTS.},
  keywords={Structured Query Language;Java;Engineering profession;Computational modeling;Education;Switches;Pattern recognition;Problem-solving;Programming profession;Python;Graduate Education;Computational Thinking;Computer Science;Computer Engineering},
  doi={10.1109/FIE63693.2025.11328630},
  ISSN={2377-634X},
  month={Nov},}

@INPROCEEDINGS{11193626,
  author={Li, Xing and Luo, JingJing and Ai, Di and Zhou, XiaoChun and Zhao, MingYue and Xiang, Hui},
  booktitle={2025 International Conference on Distance Education and Learning (ICDEL)}, 
  title={A DBVRL Approach: Developing Computational Thinking in Immersive Environments}, 
  year={2025},
  volume={},
  number={},
  pages={271-275},
  abstract={Computational thinking (CT) has emerged as a pivotal competency for navigating complex problem-solving in the digital era, yet its cultivation demands pedagogical innovations that bridge abstract concepts with tangible practice. Design-Based Learning (DBL) and Virtual Reality (VR) hold transformative potential by embedding iterative design cycles within immersive environments, prompting this study to develop a Design-Based Virtual Reality Learning (DBVRL) model that synergizes embodied VR interactions with DBL-driven tasks to enhance CT through a drone programming curriculum.},
  keywords={Technological innovation;Solid modeling;Navigation;Computational modeling;Education;Virtual reality;Problem-solving;Iterative methods;Programming profession;Drones;computational thinking;virtual reality;design-based learning},
  doi={10.1109/ICDEL65868.2025.11193626},
  ISSN={},
  month={June},}

@INPROCEEDINGS{10021019,
  author={Buchanan, Sarah A. and Gracy, Karen F. and Kitchens, Joshua and Marciano, Richard},
  booktitle={2022 IEEE International Conference on Big Data (Big Data)}, 
  title={Computational Thinking Integration into Archival Educators’ Networked Instruction}, 
  year={2022},
  volume={},
  number={},
  pages={2500-2506},
  abstract={This paper discusses the use of Computational Thinking (CT) in Archival Educators’ instruction towards enhancing the training and professional development of the library and archival workforce to meet the needs of their communities, and enhancing digital collection management and access to information and resources through retrospective and born-digital content. Four educators share their teaching strategies aimed at modernizing the way digital LIS and computational education are conducted. Their goal is to create an active and engaged community of future archival practitioners, ready to tackle the digital records and archives future.},
