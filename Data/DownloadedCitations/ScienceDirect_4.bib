pages = {215-240},
year = {2026},
isbn = {978-0-443-45526-1},
doi = {https://doi.org/10.1016/B978-0-443-45526-1.00008-8},
url = {https://www.sciencedirect.com/science/article/pii/B9780443455261000088},
author = {Hossein Pourrahmani},
keywords = {AI in engineering education, Digital transformation, Engineering curriculum evolution., Interdisciplinary learning, Virtual laboratories},
abstract = {The integration of artificial intelligence (AI) into mechanical and chemical engineering is reshaping not only industrial applications but also the way these disciplines are taught. Traditional engineering education has long been rooted in fundamental physics, mathematical rigor, and hands-on experimentation. However, the integration of AI demands a paradigm shift toward data-driven methodologies, computational modeling, and interdisciplinary learning. This chapter examines the evolving landscape of engineering education, with a focus on the transition from traditional teaching approaches to AI-enhanced curricula. It examines the role of machine learning, automation, and digital twin technology in modern engineering education while highlighting the importance of problem-solving, critical thinking, and ethics in AI-driven decision-making. Additionally, the chapter discusses emerging educational models, such as project-based learning, AI-assisted virtual laboratories, and industry-academic collaborations, to prepare future engineers for a rapidly changing technological landscape.}
}
@article{SCHREUDER2026107404,
title = {Fungicides for the management of blackleg disease of canola caused by Leptosphaeria maculans in the Western Cape province of South Africa},
journal = {Crop Protection},
