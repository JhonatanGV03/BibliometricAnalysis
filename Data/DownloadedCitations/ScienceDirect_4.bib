year = {2026},
issn = {1875-9521},
doi = {https://doi.org/10.1016/j.entcom.2026.101128},
url = {https://www.sciencedirect.com/science/article/pii/S1875952126000509},
author = {Shaoyuan Zhao and Luorong Qupi and Amir Karimi},
keywords = {Robotics in learning, Educational robotics, Human–robot interaction, Bibliometric analysis, Game-based learning},
abstract = {This study presents a comprehensive bibliometric and thematic reconstruction of Robotics in Game-Based Learning (RGBL) to elucidate its intellectual structure, methodological evolution, and emergent conceptual regimes. Using a curated Scopus dataset (1988–2025), the analysis combines performance metrics, co-authorship networks, co-word mapping, thematic cartography, and temporal trend modeling to trace RGBL’s progression from early engineering-focused, rule-based robotics games to AI-enhanced, socially and pedagogically responsive learning environments. Unlike prior reviews, which primarily offer descriptive overviews or focus narrowly on technical or educational aspects, this work integrates quantitative trend analysis with thematic evolution, revealing four dominant regimes—algorithmic adaptivity, embodied interaction, educational robotics, and socio-affective human–robot gameplay—while quantitatively highlighting gaps in inclusivity, ethical governance, and cross-cultural scalability. By systematically linking intellectual structure with longitudinal trends, the study not only maps past developments but also establishes a data-driven foundation for theory-informed, globally aware, and pedagogically grounded RGBL research, offering actionable insights for both designers and scholars seeking to advance the field beyond fragmented, short-term studies.}
}
