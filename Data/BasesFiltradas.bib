@INPROCEEDINGS{11328243,
  author={Dandekar, Ashish Deepak and Lakshmanan, Nitya and Ler, Daren and Prabawa, Adi Yoga Sidi and Rasnayaka, Sanka},
  booktitle={2025 IEEE Frontiers in Education Conference (FIE)}, 
  title={Scaffolding the Problem-Solving Process for Introductory Computing Students}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Many introductory computing courses focus on syntax and semantics, where students are required to inductively develop problem-solving skills by working on many programming assessments. When we adopted this approach in a CS1 course with over 400 students, we observed that many students were indeed able to adapt. However, a significant number struggled due to insufficient scaffolding, often spending excessive amounts of time on their assignments, leading to poor performance and a high probability of failure. In this paper, we introduce a structured framework, coined the Computational Thinking and Problem Solving framework, that is designed to support students enrolled in introductory computing courses. We show that the proposed intervention had a positive and statistically significant impact on student performance.},
  keywords={Semantics;Syntactics;Probability;Problem-solving;Programming profession;Problem Solving;Computational Thinking},
  doi={10.1109/FIE63693.2025.11328243},
  ISSN={2377-634X},
