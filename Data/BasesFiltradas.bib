  pages={52-56},
  abstract={Cultivating computational thinking in university students has become a central focus of modern education, particularly in STEM disciplines. How to put computational thinking training into practice in instructional strategy design is a problem worth researching. This paper firstly provides an understanding of the nature, status and role of the Digital Signal Processing (DSP) course. On this basis, instructional design research is carried out from the aspects of ``higher order'' objective design, instructional model reform and evaluation design. The results show that integrating STEM concepts into DSP courses can significantly improve students' computational thinking skills. The research findings provide an effective practical reference for exploring instructional models for computer science.},
  keywords={Computer science;Training;Knowledge engineering;Computational modeling;Education;Digital signal processing;STEM;Context modeling;STEM education;computational thinking;digital signal processing course;instructional model},
  doi={10.1109/CSTE64638.2025.11092078},
