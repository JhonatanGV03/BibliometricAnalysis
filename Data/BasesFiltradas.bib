  abstract={This paper conducts a visual analysis of research literature on big data courses using CiteSpace software, revealing the research hotspots, developmental trajectories, and emerging trends in big data course studies. International course systems establish a comprehensive research chain of "computational thinking → analytics lifecycle → societal impact", focusing on technological application and theoretical innovation. This study provides valuable insights for the design and optimization of big data courses in higher education institutions. Future research could expand data sources and include comparative analyses of courses from more countries and regions.},
  keywords={Visualization;Technological innovation;Soft sensors;Focusing;Knowledge graphs;Big Data;Market research;Trajectory;Iterative methods;Optimization;Big Data Courses;Data Analysis;Data Mining;Knowledge Graph},
  doi={10.1109/ICDEL65868.2025.11193596},
