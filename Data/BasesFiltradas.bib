@INPROCEEDINGS{11238498,
  author={Soto, Jose D. and Lancheros, Estefany and Diaz, Lauriza and Diaz, Jesus David Alfaro and Barrios, Franklin and Guerrero, Vladirmir Cudris and Comas-González, Zhoe and Aragon, Maria and Ramírez, Javier and Deluquez, Jair Eviel Barrios and Coll, Jean Pierre and Espitia-Lopez, Jose V.},
  booktitle={2025 IEEE Technology and Engineering Management Society (TEMSCON LATAM)}, 
  title={BAQSTEM: Collaborative Ecosystem for STEM Education: Robotics Case Study}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={BAQSTEM + IS 2024 promotes social inclusion and STEM skill development through experiential robotics challenges and mentorship. Coordinated by the Secretary of Education of Barranquilla and seven universities, the program engaged students from 66 public and private schools, emphasizing gender equity with 45% female participation. Using the CDIO (Conceive, Design, Implement, Operate) framework, students enhanced problem-solving, teamwork, and computational thinking, while teachers advanced their technical mentoring skills. The initiative bridged educational gaps between diverse socioeconomic groups, strengthened university-school partnerships, and fostered long-term interest in STEM fields. Future efforts will expand regional impact and introduce advanced technologies to sustain and scale the program.},
  keywords={Training;Robot kinematics;Scalability;Ecosystems;Teamwork;Problem-solving;Mentoring;Socioeconomics;Programming profession;STEM;STEM Education;Robotics;Computational Thinking;Educational Challenges;BAQSTEM;Collaborative Ecosystem},
