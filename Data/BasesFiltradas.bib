@INPROCEEDINGS{11328251,
  author={Park, Jinsook and Jung, Andrew},
  booktitle={2025 IEEE Frontiers in Education Conference (FIE)}, 
  title={WIP: Enhancing Computational Thinking and Engagement of Undergraduate Students Through Collaborative Game Development in the Interdisciplinary Course}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This research WIP study demonstrates how an interdisciplinary, game-based curriculum integrating programming, mathematics, and effectively enhances computational thinking (CT). Project-based learning yielded measurable CT improvements through flowchart complexity analysis, with high engagement evidenced by full participation. The approach successfully cultivated both technical and soft skills while bridging STEM domains. Findings confirm its efficacy in developing problem-solving abilities and motivation across disciplines. Future research directions include investigating longitudinal outcomes, skill transferability, platform comparisons, and broader implementation strategies for diverse educational contexts.},
  keywords={Flowcharts;Federated learning;Atmospheric measurements;Collaboration;Games;Particle measurements;Mathematics;Complexity theory;Problem-solving;Programming profession;collaborative learning;computational thinking;engagement;game development;undergraduate},
