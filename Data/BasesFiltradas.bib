@INPROCEEDINGS{9453929,
  author={Ye, Jiachu and Lai, Xiaoyan and Wong, Gary K.W.},
  booktitle={2021 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={The influence of students’ computer science learning experience on their perception of computational thinking}, 
  year={2021},
  volume={},
  number={},
  pages={1495-1496},
  abstract={This systematic review aims to explore how students' CS learning experience influences their perception of computational thinking. We identified 21 publications in SCOPUS and coded them for comparison and synthesis. Through a meta-analysis, we found a medium effect size (g =0.656; p<; 0.001) supporting the influence of CS learning on students' change of perception of CT. Through qualitative synthesis, results show that CS learning experience influences perception of CT in terms of self-efficacy, behavioral & emotional engagement, and awareness of careers. Findings provide insights to facilitate CT education strategies and promote educational equity in the STEM field.},
  keywords={Computer science;Systematics;Engineering profession;Conferences;Engineering education;computational thinking;perception;CS education},
  doi={10.1109/EDUCON46332.2021.9453929},
  ISSN={2165-9567},
  month={April},}

@INPROCEEDINGS{11340251,
  author={Teran, Hector and Barrera, Alejandro Corrales and Leal, Jimmy Garcia and Cortez, Laura Ocampo and Vasquez, Laura and Peñata, Luis Perez and Coba, Esteban Espitia},
  booktitle={2025 IEEE Colombian Caribbean Conference (C3)}, 
  title={Unplugged Activities to Support Computational Thinking in Youth from Low-Income Backgrounds}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Computational Thinking (CT) has emerged as a critical skill for addressing complex problems across multiple disciplines in the digital era. However, students from low-income backgrounds often face limited access to highquality computer science education, which exacerbates the digital divide. To address this challenge, unplugged activities offer a practical and inclusive approach to introducing CT concepts without requiring access to computers or the Internet. This study presents a contextualized implementation framework based on a cascading learning model: university students trained high school seniors, who, in turn, facilitated unplugged CT activities for primary school students. The initiative was applied in selected educational contexts with limited technological infrastructure. Preliminary qualitative observations indicate positive engagement and improved understanding of CT-related skills among participants. While comprehensive quantitative analyses are still ongoing, initial results suggest that unplugged activities can effectively complement efforts to reduce educational inequities. Future research will include the integration of formal assessment instruments to evaluate learning gains more robustly.},
  keywords={Leadership;Humanities;Statistical analysis;Computational modeling;Instruments;Organizations;Computer science education;Teamwork;Digital divide;Problem-solving;CS Unplugged;Computational Thinking;Educational Equity;Cascading Learning Model},
  doi={10.1109/C366505.2025.11340251},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{11460247,
  author={Lee, Claire and Park, Jiyoon and Shin, Catherine},
  booktitle={2025 IEEE Integrated STEM Education Conference (ISEC)}, 
  title={The Gap Between Computational Thinking and Coding, and How to Bridge it}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Learning a foreign language usually involves mastering words and grammar to understand sentence patterns. In contrast, coding languages have fewer keywords and simpler grammar, yet they allow for diverse solutions through combinations. This complexity often leads to uncertainty about which syntax to apply in specific situations during problem-solving, making coding challenging. Computational Thinking (CT) aims to bridge this gap by suggesting when to use certain syntax, but Wing's CT concept focuses on human problem-solving, not aligning directly with coding. Meanwhile, Scratch's CT approach is effective for teaching basic computational concepts but lacks a robust theoretical framework for problem solving.This paper proposes a hybrid method combining these strengths: using block coding like Scratch for foundational learning, and applying Wing’s CT from a computer perspective for problem-solving. It showcases a developed website aimed at implementing this educational strategy. The site (https://block4py.org) is publicly available and aims to assist beginners in coding.},
  keywords={Protocols;HTTP;Learning (artificial intelligence);Artificial intelligence;Learning systems;Computers;Python;Computer languages;Computers and information processing;Public domain software;Computational Thinking;Block coding;Hybrid method},
  doi={10.1109/ISEC64801.2025.11460247},
  ISSN={2473-7623},
  month={March},}

@INPROCEEDINGS{10630739,
  author={Nobnop, Ratchanon and Chondamrongkul, Nacha and Temdee, Punnarumol},
  booktitle={2024 5th Technology Innovation Management and Engineering Science International Conference (TIMES-iCON)}, 
  title={Assessing Self-Efficacy Method for Enhancing Computational Thinking in Educational Game Environment}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Self-efficacy is critical for improving computational thinking in gaming. However, conventional assessment methods like questionnaires can produce disengaged responses or require additional work to understand the questions and have limitations in the assessment of dynamic self-efficacy. To address this challenge, this study proposes a method using in-game features to assess self-efficacy, which can change over the playtime. The employed in-game feature is the Planning Stage, in which learners strategize and prepare their approach before engaging with challenges. We collect data on the time spent in this stage, which is newly proposed in this study. The experiment was conducted with twenty-five students in the Multimedia Technology and Animation Major playing Tenacity-P to accomplish tasks from a computer programming course. To validate the method, we compared self-efficacy results from the game-based approach with those from conventional questionnaires. The findings highlight the need for strategic planning in managing difficult tasks. As challenges increased, performance measures varied more, underscoring the importance of strong problem-solving skills. Efficient strategic planning directly improved self-efficacy, as participants with better planning skills maintained higher self-efficacy despite increasing task difficulty.},
  keywords={Games;Strategic planning;Innovation management;Animation;Particle measurements;Real-time systems;Problem-solving;Computational Thinking;Educational game;Game features;Self-efficacy},
  doi={10.1109/TIMES-iCON61890.2024.10630739},
  ISSN={},
  month={June},}

@INPROCEEDINGS{9815999,
  author={Barrett, Alex and Zhang, Nuodi and Ke, Fengfeng and Moon, Jewoong and Sokolikj, Zlatko},
  booktitle={2022 8th International Conference of the Immersive Learning Research Network (iLRN)}, 
  title={Work-in-progress—Developing an Evidence-Centered Model for Computational Thinking in Virtual Worlds with Children with Autism}, 
  year={2022},
  volume={},
  number={},
  pages={1-3},
  abstract={This work-in-progress paper reports on the establishment of preliminary reliability for a domain-agnostic evidence-centered assessment model to measure computational thinking (CT) in an online virtual world. Preliminary reliability was established between two researchers through manually coding 800 minutes of recorded learning sessions and over 350 minutes of consultation. Participants were three adolescents diagnosed with autism spectrum disorder. Findings indicate an acceptable level of reliability between the two coders, opening the way to more extensive application of the model in future studies.},
  keywords={Autism;Atmospheric measurements;Computational modeling;Particle measurements;Encoding;Reliability;computational thinking;evidence-centered design;behavioral coding;virtual worlds;autism spectrum disorder},
  doi={10.23919/iLRN55037.2022.9815999},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11092183,
  author={Li, Zhou and Zheng, Xiyu and Fu, Qian},
  booktitle={2025 7th International Conference on Computer Science and Technologies in Education (CSTE)}, 
  title={Exploring the Computational Thinking Process of College Students: Collaborative Programming with LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={6-10},
  abstract={Computational thinking (CT) has gained increasing attention from educators and practitioners due to its effectiveness in fostering student development, particularly in programming courses. Meanwhile, with the rapid advancement of large language models (LLMs), an increasing number of teachers and students are incorporating AI-assisted teaching and learning. However, empirical research on the patterns of CT processes when students adopt different AI-assisted learning strategies remains limited. This study explores the differences in CT process patterns when students use two different types of LLMs: General AI Group (GAIG) and No Code AI Group (NCAIG). Results showed that: (1) The social perspective is the most dominant in CT (2) Questioning and connecting co-occur most often, followed by connecting and sequencing, as well as questioning and sequencing; (3) Students' prior knowledge significantly affects their CT patterns. These findings provide empirical support for educators to effectively guide students in leveraging AI technology to enhance CT in instructional settings.},
  keywords={Sequential analysis;Codes;Large language models;Education;Collaboration;Programming profession;computational thinking;CT;LLM;program;AI},
  doi={10.1109/CSTE64638.2025.11092183},
  ISSN={},
  month={April},}

