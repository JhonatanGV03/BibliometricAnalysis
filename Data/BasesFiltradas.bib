@article{WANG2026103582,
title = {Modeling students' intentions toward AI-supported learning: Evidence from primary schools in the Xizang Autonomous Region of China},
journal = {International Journal of Educational Development},
volume = {123},
pages = {103582},
year = {2026},
issn = {0738-0593},
doi = {https://doi.org/10.1016/j.ijedudev.2026.103582},
url = {https://www.sciencedirect.com/science/article/pii/S0738059326000921},
author = {Na Wang and Shencheng Gan and Lei Du},
keywords = {AI-supported learning, PLS-SEM, Xizang primary education, UTAUT, Self-efficacy, School location},
abstract = {China's "Education Digitalization Strategic Action" identifies artificial intelligence (AI) as a pivotal tool for advancing equitable and high-quality basic education. As an autonomous region with distinctive cultural traditions and geographic characteristics, Xizang has been designated a pilot area for smart education initiatives. Examining primary students' acceptance of AI-supported learning in this context is therefore essential for promoting educational informatization in Xizang and for shaping policy strategies in other multi-ethnic regions. This study employs the Unified Theory of Acceptance and Use of Technology (UTAUT), extending the framework by incorporating self-efficacy (SE) as an additional predictor and considering school location (urban, township, rural) and gender as moderating variables. Data from 392 valid questionnaires completed by Xizang primary students were analyzed using PLS-SEM. The results indicate that Social Influence (SI), Effort Expectancy (EE), and SE significantly predict Behavioral Intention (BI), while Facilitating Conditions (FC) and BI positively influence Use Behavior (UB). School location negatively moderates the SI→BI and FC→UB paths, reflecting urban-rural variation in adoption, whereas gender exerts no significant moderating effect. By extending the UTAUT model and illuminating regional differences, this study offers empirical evidence to inform policies that combine infrastructural investment with localized pedagogical strategies, providing practical recommendations for advancing AI-supported learning in Xizang and comparable regions.}
}

@incollection{KUMAR2024147,
title = {Chapter Eight - Machine learning model for teaching and emotional intelligence},
editor = {Muskan Garg and Deepika Koundal},
booktitle = {Emotional AI and Human-AI Interactions in Social Networking},
publisher = {Academic Press},
pages = {147-168},
