@INPROCEEDINGS{11280206,
  author={Jurinová, Jana and Beňo, Miroslav},
  booktitle={2025 International Conference on Emerging eLearning Technologies and Applications (ICETA)}, 
  title={Web Application for the Development of Algorithmic Thinking and Programming Skills: Synergistic Integration of Code Visualisation, Memory Model, and Doubly Linked List in C}, 
  year={2025},
  volume={},
  number={},
  pages={299-307},
  abstract={C programming remains challenging in practice due to persistent issues with pointers, interactions between stack frames and heap-allocated objects (address passing, data lifetime), and the correctness of operations on doubly linked lists. Existing tools often lack an integrated environment that synchronises source-code stepping with faithful visualisation of memory states and structural invariants. This work presents an interactive web-based application that combines line-by-line execution, explicit simulation of stack and heap memory, and graphical representation of doubly linked list nodes, including their contents and connections. The approach enables users to analyse program semantics, memory behaviour, and structural consistency with immediate visual feedback. A pilot study with N=22 participants compared against a reference group (N=33) indicated that the tool facilitated more reliable handling of dynamic memory, improved accuracy in pointer manipulation, and enhanced engagement with code analysis tasks. Results suggest that integrated code stepping with explicit memory simulation and structural state tracking is a promising method for advancing algorithmic reasoning, critical analysis, and the design of robust and maintainable C implementations.},
  keywords={Visualization;Codes;Computational modeling;Heuristic algorithms;Semantics;Data visualization;Programming;Data models;Reliability;Manipulator dynamics;algorithmic thinking;critical thinking;computational thinking;programming skills;data structures;code visualisation;memory model;active learning methods},
  doi={10.1109/ICETA67772.2025.11280206},
  ISSN={},
  month={Nov},}

