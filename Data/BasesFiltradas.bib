@INPROCEEDINGS{11387186,
  author={Melgarejo-Heredia, Rafael and García-Ruíz, Alejandro},
  booktitle={2025 International Conference on Education Technology and Computers (ICETC)}, 
  title={Enhancing Computational Thinking through AI-Supported, Intercultural Collaborative Learning: A Global Shared Learning Experience with Python}, 
  year={2025},
  volume={},
  number={},
  pages={740-744},
  abstract={This study explores the impact of integrating artificial intelligence (AI) tools and intercultural collaboration on the development of computational thinking (CT) skills in higher education. Implemented through the Global Shared Learning (GSL) methodology, the initiative connected students from Tecnológico de Monterrey (TEC) and the Pontificia Universidad Católica del Ecuador (PUCE) in a collaborative Python-based learning environment. Employing a mixed-methods design, the study examined students' perceived ease of problem-solving, intercultural engagement, and interest in continuing to learn Python and AI. Results indicate that AI tools significantly improved problem-solving efficiency and reduced perceived difficulty. Intercultural collaboration was positively received, enhancing cultural awareness and communication skills. Furthermore, 88% of participants expressed a strong interest in continuing to learn Python and AI. These findings support the integration of AI-enhanced, culturally diverse learning environments as effective strategies for advancing CT education. Recommendations include differentiated support for beginners, inclusive pedagogical strategies, and infrastructure improvements to foster equitable access.},
  keywords={Surveys;Education;Computational efficiency;Teamwork;Problem-solving;Cultural differences;Artificial intelligence;Programming profession;Python;Videos;Computational Thinking;Artificial Intelligence;Intercultural Collaboration;Python Programming;Global Shared Learning;Higher Education},
  doi={10.1109/ICETC66579.2025.11387186},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{11092204,
  author={Guo, Yansha},
  booktitle={2025 7th International Conference on Computer Science and Technologies in Education (CSTE)}, 
  title={Project-based Teaching Design for Undergraduate Computer Courses Incorporating STEM Concept and Computational Thinking}, 
  year={2025},
  volume={},
  number={},
  pages={66-71},
  abstract={Integrating the STEM concept and computational thinking (CT-STEM) comprehensively into the teaching of undergraduate courses can not only significantly improve teaching quality and effectiveness but also promote students' development in many aspects. However, how to effectively integrate CT-STEM into every link of undergraduate curriculum teaching by means of task-driven approaches, project-based cases and other methods still remains to be further explored and tapped. Based on this, taking the chapter "Database Connection and Application" as an example, this paper explores how to use a project-based case, the task-driven method, and group collaboration to comprehensively integrate CT-STEM into the teaching process of specialized courses through four key phases: pre-class design, in-class development, post-class assignments, and project evaluation. The purpose is to strengthen students' higher-order thinking and teamwork awareness, thereby improving their comprehensive abilities to analyze and solve complex problems. The entire idea of the project-based teaching design elaborated in this paper can serve as a valuable reference for university teachers and educators.},
  keywords={Knowledge engineering;Computer science;Technological innovation;Databases;Design methodology;Computational modeling;Education;Layout;Teamwork;STEM;project-based case;task-driven method;teaching design;STEM concept;computational thinking},
  doi={10.1109/CSTE64638.2025.11092204},
  ISSN={},
  month={April},}

@INPROCEEDINGS{11413256,
  author={Lan, Li and Lyu, Huimin and Ding, Yuelin and Guo, Dingding},
  booktitle={2025 International Conference on Educational Technology Management (ICETM)}, 
  title={Factors in Gamified Programming Platforms Affecting Elementary Students' Computational Thinking}, 
  year={2025},
  volume={},
  number={},
  pages={410-414},
  abstract={This study focuses on the influencing factors of programming gamification platforms on the development of computational thinking in primary school students. In the context of the digital transformation of education and the growing trend of younger students in programming education, although the platform is widely used, the influencing factors are still unclear. The study adopts a mixed research method combining literature research and questionnaire survey, and finds that platform design, teaching strategies, and individual student characteristics interact with each other to influence the cultivation effect. Compared with previous studies, this study refines the influencing mechanisms, explores the differences in the adaptability of teaching methods, and comprehensively considers student factors. The research results enrich the theoretical system, practice guidance, and can be further deepened in terms of quantifying the influence and broadening the scope of research.},
  keywords={Surveys;Digital transformation;Education;Educational technology;Market research;Cultural differences;Programming profession;Systematic literature review;gamified programming platform;elementary school students;computational thinking;influencing factors},
  doi={10.1109/ICETM67477.2025.11413256},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{9477642,
  author={Ren, Haodong and Yang, Li and Jiang, Liheng and Bai, Yu and Lu, Wei and Chang, Jie},
  booktitle={2021 IEEE 3rd International Conference on Computer Science and Educational Informatization (CSEI)}, 
