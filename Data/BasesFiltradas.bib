@INPROCEEDINGS{11194880,
  author={Coura, Laura and Gonzaga, Júlia and Fortes, Reinaldo and Bianchi, Andrea and Gertrudes, Jadson and Ilídio, Rone and Delabrida, Saul},
  booktitle={2025 IEEE International Conference on Advanced Learning Technologies (ICALT)}, 
  title={Training Teachers to Design Virtual Reality Games: A Brazilian Context Experience}, 
  year={2025},
  volume={},
  number={},
  pages={284-286},
  abstract={The integration of serious educational games in Virtual Reality (VR) in schools is rising due to their high interactivity and the incorporation of entertainment into education, a trend that may result in more interest and participation among students. However, teachers often face challenges when using these tools due to their limited knowledge. To address this issue, we developed a qualification workshop to teach primary school teachers how to apply Computational Thinking to create educational games in VR. This work outlines the creation and implementation of the workshop and discusses the results obtained through observation and participant feedback. The findings show that the workshop structure was effective and suggest some adjustments for future interactions. Additionally, the participants completed the workshop and were able to design educational games relevant to their teaching areas.},
  keywords={Conferences;Entertainment industry;Games;Virtual reality;Market research;Reflection;Serious games;Internet;Faces;Qualifications;Educational Serious Games;Virtual Reality;Game Design;Teacher Training},
