  number={},
  pages={1-8},
  abstract={The pandemic caused by Covid-19 – Coronavirus forced government authorities to take quick action against the virus, within the framework of these measures, borders, social distancing, confinement, cancellation of face-to-face attendance and implementation of teleworking were interrupted, and effective solutions were sought for the protection of physical health and care of life. However, mental health was neglected, triggering depression, anxiety, different types of violence, suicidal ideation, and action, among other factors. Directly affecting individuals in their environment, emotions, and perceptions. With the understanding of the demands in mental health care, the research team made an interdisciplinary proposal focused on the inhabitants of the department of Cauca, methodologically used a mixed research approach, applying qualitative instruments such as focus groups, debates with experts, discursive analysis; in quantitative, analysis of secondary sources, compilation, and review of reports. As a result, a technological platform was built to favor decision-making by state actors, a virtual learning object, a training process for 210 actors such as technical assistance, installed capacity in the 42 Municipalities of Cauca, a base document for the formulation of public policies in mental health and primary care for 60,000 people through face-to-face visits or teleorientation.},
  keywords={COVID-19;Training;Statistical analysis;Pandemics;Mental health;Software;Social factors;Mental health;technological tools;Covid 19;primary care;computational thinking},
  doi={10.1109/AmITIC60194.2023.10366351},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{11328240,
  author={Martinez, Julio R. and Chong, Mario and Maya, Susana and Caicedo, María Alejandra and Luna, Ana},
  booktitle={2025 IEEE Frontiers in Education Conference (FIE)}, 
  title={Enhancing Algorithmic Thinking and Emotional Resilience in Programming Education Through AI Powered Virtual Tutoring}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This full research-to-practice paper addresses key challenges in programming education within engineering, particularly the uncritical use of generative AI (GenAI) and its potential to hinder independent learning. It introduces JULIUS, an AI-powered chatbot designed to serve as a virtual tutor in a Fundamentals of Programming course, aiming to enhance technical skills, emotional resilience, and student confidence. Grounded in connectivism and Challenge-Based Learning (CBL), JULIUS promotes autonomy, reduces anxiety, and supports real-world problem-solving through structured group dynamics and tools like Excel and PSeInt. A mixed-methods approach combined quantitative pre- and post-tests with qualitative thematic analysis. Results show significant improvements in conceptual understanding, logical reasoning, motivation, and collaboration. JULIUS also enhanced emotional well-being, metacognition, and teamwork, addressing cognitive and affective learning needs. The findings underscore JULIUS's effectiveness in bridging theory and practice while supporting adaptive and collaborative learning. This research highlights the potential of AI-driven tools to transform engineering education by promoting deeper learning, reducing anxiety, and improving group dynamics, aligning with broader trends in digital transformation and educational innovation.},
  keywords={Technological innovation;Heuristic algorithms;Anxiety disorders;Transforms;Metacognition;Market research;Teamwork;Problem-solving;Programming profession;Resilience;E-learning;Challenge Based Instruction;computational thinking;critical thinking},
  doi={10.1109/FIE63693.2025.11328240},
  ISSN={2377-634X},
  month={Nov},}

