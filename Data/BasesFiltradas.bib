@INPROCEEDINGS{11132019,
  author={Moguš, A. Mirković and Varga, R. and Kiralj, V.},
  booktitle={2025 MIPRO 48th ICT and Electronics Convention}, 
  title={Prospective Kindergarten Teachers' Readiness to Integrate Computational Thinking into Early Childhood Education}, 
  year={2025},
  volume={},
  number={},
  pages={514-519},
  abstract={This study explores the perspectives of prospective kindergarten teachers regarding the integration of computational thinking (CT) in early childhood education (ECE), focusing on their self-assessed CT skills and attitudes toward implementing CT-related activities in the ECE settings. Recognizing the growing importance of CT as a fundamental life skill, this research aimed to assess the readiness of university students enrolled in the ECE program to integrate CT into their professional practice. Students in the first, second and third year of the bachelor study program were asked to self-assess their CT knowledge, skills and attitudes in an online survey. The results indicate that students exhibit a varied level of CT knowledge and skills: they excel in creativity, whereas the algorithmic thinking skill is perceived to be the least developed skill. In addition, they expressed overall positive attitudes toward incorporating CT activities in ECE, highlighting the potential benefits for children's cognitive and developmental growth. These insights underline the need for targeted training and curriculum adjustments to prepare future educators for implementing CT in their pedagogical practices. This study contributes to understanding of the readiness of prospective kindergarten teachers to adopt innovative educational approaches and provides a foundation for enhancing study programs to support CT in ECE.},
  keywords={Training;Surveys;Focusing;Collaboration;Problem-solving;Cultural differences;Creativity;algorithmic thinking;children;preschool;students;teacher competences},
  doi={10.1109/MIPRO65660.2025.11132019},
  ISSN={1847-3938},
  month={June},}

@INPROCEEDINGS{11500019,
  author={Bhatt, Shubham S. and Hsiao, Michael S.},
  booktitle={2025 Artificial Intelligence x Humanities, Education, and Art (AIxHEART)}, 
  title={RL-Optimized Natural Language Prompts for Enabling User-Centric Computational Thinking via Small-Scale LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={We introduce a reinforcement learning (RL)-based framework to optimize discrete natural language prompts for enhancing both the accuracy and clarity in sentence simplification. Using a lightweight PPO policy, our method learns to guide a frozen small-scale LLaMA-3.2B model toward effective simplification for supporting user-centric computational thinking tasks. Results show that our RL-optimized prompts significantly surpass manual baselines in semantic fidelity, logical coherence, and instructional quality. Moreover, the proposed RL-optimized prompting approach enables a much smaller LLM to achieve results that are comparable in clarity and instructional value to those produced by a much larger LLaMA-3.3 70B model.},
  keywords={Feeds;Filtering;Filters;Feedback;Circuits;Circuits and systems;LoRa;Protocols;HTTP;Data communication;Prompt optimization;Reinforcement Learning;Sentence Simplification;Educational AI},
