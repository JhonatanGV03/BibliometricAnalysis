@INPROCEEDINGS{10981347,
  author={Sheridan, Frances and Stynes, Paul and Pathak, Pramod and Quille, Keith},
  booktitle={2025 IEEE Engineering Education World Conference (EDUNINE)}, 
  title={Work in Progress: Computational Thinking Skills Assessment in Higher Education}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The goal of this research is to identify a tool for use in assessing Computational Thinking Skills in undergraduate Computing students. To measure the effectiveness of interventions for the development of Computational Thinking skills, there is a need for valid and reliable assessment tools. Much of the research to date has been concentrated in primary and secondary education with a shortfall in research for higher education settings. This research aims to try and address this gap and is comprised of three main stages: a literature review; a pre-pilot study; and a pilot study. The literature review identified a validated tool with potential for use with undergraduate Computing students. The pre-pilot and pilot studies invited participants to engage with the tool, but engagement was limited with low participation rates. This paper examines the reasons for this and explores possible ways to move the research forward considering these challenges.},
  keywords={Reliability;Engineering education;Systematic literature review;Computational Thinking;Assessment;Higher Education},
  doi={10.1109/EDUNINE62377.2025.10981347},
  ISSN={},
  month={March},}

@INPROCEEDINGS{11368336,
  author={Costa, Maria José and Piedade, João},
  booktitle={2025 International Symposium on Computers in Education (SIIE)}, 
  title={Tangible Educational Robotics as a Pedagogical Strategy for Fostering Computational Thinking in Early Elementary Education: A Systematic Literature Review}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This systematic literature review aimed to analyse the effectiveness of using tangible educational robots, without use of digital programming environments, in developing Computational Thinking skills among Early Elementary Education ($1^{\text {st }}$ to $4^{\text {th }}$ grade). Applying the PRISMA protocol, seven empirical studies published between 2019 and 2024 were selected based on rigorous inclusion criteria. The findings suggest that tangible robotics significantly contributes to the development of Computational Thinking by providing a motivating and hands-on learning environment. Furthermore, these approaches promote not only disciplinary learning but also the development of social and collaborative skills. However, the lack of a systematic theoretical framework and the absence of direct comparisons with other methodologies highlights important gaps in the literature. This review underlines the need for further research in a broader scope, a longitudinal study design, and situated in a greater diversity of educational contexts.},
  keywords={Computers;Systematics;Protocols;Educational robots;Education;Collaboration;Cultural differences;Systematic literature review;Programming environments;Computational Thinking;Early Elementary Education;Educational Robotics},
  doi={10.1109/SIIE68580.2025.11368336},
  ISSN={2476-2172},
  month={Nov},}

@INPROCEEDINGS{10685722,
  author={Gao, Hanrui and Zhang, Yi and Wang, Kang and Yu, Fan and Li, Tianyu},
  booktitle={2024 International Symposium on Educational Technology (ISET)}, 
  title={Using 3D Virtual and Physical Robot Alone or Together-Which Works Better for Learning engagement and Computational Thinking}, 
  year={2024},
