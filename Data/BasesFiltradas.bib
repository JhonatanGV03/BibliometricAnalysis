@INPROCEEDINGS{11346697,
  author={Luo, Qi and Zhang, Shuhan and Wen, Jiamei},
  booktitle={2025 IEEE International Conference on Teaching, Assessment, and Learning for Engineering (TALE)}, 
  title={Exploring the Relationship Between Personality and Computational Thinking in Young Children}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Computational thinking (CT) has been widely integrated into K–12 education globally, accompanied by increasing efforts to identify factors that influence its development. While cognitive correlates of CT have been extensively studied, growing evidence highlights the potential role of non-cognitive factors, particularly personality traits, in shaping students’ CT performance. However, the association between personality and CT remains underexplored among lower primary students. To address this gap, the present study pursued two main objectives. First, we translated and validated the Chinese version of the Big Five Questionnaire for Children (CBFQ-C) with a large sample of 1,794 students from Grades 2 to 6. Second, we examined the relationship between personality traits and CT performance in a subsample of 183 second-grade students. The findings extend previous research by demonstrating that personality-CT associations are also observable in early primary school students and highlight the importance of incorporating personality traits into future CT-related educational practices and interventions.},
  keywords={Education;computational thinking;personality;Big Five children;primary education},
  doi={10.1109/TALE66047.2025.11346697},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{11351720,
  author={Abiyu, Raditya Naufal and Abetnego, Hosea Nathanael and Yoni, Razzan Daksana and Mulyanto, Adi and Dewandaru, Agung},
  booktitle={2025 IEEE International Conference on Data and Software Engineering (ICoDSE)}, 
  title={Solvio: An Interactive and Gamified Platform for Teaching Computational Thinking}, 
  year={2025},
  volume={},
  number={},
  pages={467-471},
  abstract={Traditional platforms for learning Computational Thinking (CT), like the Bebras Challenge, often use static problem formats that limit student interaction and conceptual understanding. This paper introduces Solvio, a web-based platform that transforms static CT problems into dynamic, interactive, and gamified learning modules. Solvio features a modular frontend architecture, a robust backend service, and three core interactive modules: Classical Ciphers, Context-Free Grammar (CFG), and Decision Trees. The platform incorporates gamification elements like leaderboards, scoring, and daily streaks to enhance user engagement. Functional black-box testing confirmed all system features perform as designed. Usability testing with target users yielded a high System Usability Scale (SUS) score of 74 (“Good”) and a Net Promoter Score (NPS) of +60 (“Excellent”), indicating strong user acceptance and ease of use. Solvio demonstrates the effectiveness of converting static problems into interactive experiences, providing a functional and engaging tool for CT education. Future iterations of Solvio will explore comparative studies involving traditional Bebras problems and integrate educator-oriented features to support classroom use.},
  keywords={Ciphers;Closed box;Transforms;Educational technology;Computer architecture;Grammar;Decision trees;Usability;Testing;Software engineering;Computational Thinking;Interactive Learning;Gamification;Bebras Challenge;Educational Technology},
  doi={10.1109/ICoDSE68111.2025.11351720},
  ISSN={2640-0227},
  month={Oct},}

@INPROCEEDINGS{9782386,
  author={Alvarado, Lorena and Falcon, Carla and Gutiééérrez-Cááárdenas, Juan and Romero-Romero, Vilma S.},
  booktitle={2022 IEEE World Engineering Education Conference (EDUNINE)}, 
  title={Teaching of the Yupana with the Tawa Pukllay method for developing the Computational Thinking in children}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={The present research aimed to assess if the teaching of the Yupana using the Tawa Pukllay method developed by Prem [16] enables to develop the computational thinking (CT) in children of 10 and 11 years old. For this purpose, a quasi-experiment with 52 children of two elementary schools located in Lima, Peru was performed. The obtained results were statistically significant showing that the experimental group, comprised with the students who were trained with the Yupana improved their CT compared to the control group, in which the students kept doing their regular activities. This highlights the fact that using this ancestral math tool could serve as an instrument to develop the CT in children.},
  keywords={Instruments;Conferences;Engineering education;Computational thinking;Yupana;distance learning;quasi-experiments},
  doi={10.1109/EDUNINE53672.2022.9782386},
  ISSN={},
  month={March},}

@INPROCEEDINGS{9725170,
  author={Rodrigues, Claudio Ferreira and Silveira, Ismar Frango},
  booktitle={2021 XVI Latin American Conference on Learning Technologies (LACLO)}, 
  title={Gamified forms: a proposal for teaching training based on Computational Thinking}, 
  year={2021},
  volume={},
  number={},
  pages={570-573},
  abstract={The disappointing results that Brazilian education has been showing in external evaluations by international organizations cause us concern. Technologies are here to stay and it is therefore necessary, in some way, to change this paradigm with regard to the role that the teacher plays, from consumer to producer of technological resources. And, trying to contribute to this extremely complex scenery, this paper intends to show how a proposal launched in teacher education combined aspects of gamification and computational thinking, aiming to bring another look at teaching practice, or at least, increase the pedagogical repertoire of fellow Science and Mathematics teachers who participated in the meeting promoted by the Department of Education of the city of Taubaté, in the state of São Paulo. As a proposal, a suggestion of gamified activity in the style of a game known as “escape room” was presented, using the Google Forms tool. We note that insecurity with technological tools or lack of knowledge about some features of these same tools is still a factor that causes many concerns among teachers. We concluded that reflection on ourpractice is fundamental, and, in a way, we realize that we have managed to broaden our horizons about the use of certain technological tools.},
  keywords={Training;Urban areas;Organizations;Games;IEEE Fellows;Reflection;Mathematics;Computational Thinking;Gamification;Teacher Training},
  doi={10.1109/LACLO54177.2021.00105},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{10083435,
  author={Šaloun, Petr and Kolárová, Michaela and Andrešič, David and Malčik, Martin and Klement, Milan},
  booktitle={2022 IEEE 16th International Scientific Conference on Informatics (Informatics)}, 
  title={Teen-sexting on Social Network “Instagram” and it's Computational Thinking Consequences}, 
  year={2022},
