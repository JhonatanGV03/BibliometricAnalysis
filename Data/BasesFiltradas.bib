@INPROCEEDINGS{11100911,
  author={Yu, Chih-Hung},
  booktitle={2025 6th International Conference on Information Technology and Education Technology (ITET)}, 
  title={Effects of an Art-Oriented STEAM Course on Programming Learning Attitudes and Outcomes}, 
  year={2025},
  volume={},
  number={},
  pages={102-106},
  abstract={This study implemented a STEAM-based approach to design an art-oriented programming course to improve students’ learning attitudes and performance. This study was conducted over 16 weeks with 31 undergraduate students in a Design and Making in Computer Animation course. Quantitative and qualitative data were collected to evaluate changes in learning programming and explore possible gender differences. The findings revealed that the STEAM course significantly enhanced students’ enjoyment but did not lead to noticeable improvements in learning anxiety or perceived playfulness. Male students generally showed more positive learning attitudes, although no significant gender differences were observed in actual programming performance. Students expressed high satisfaction with the course and demonstrated strong interdisciplinary integration in their final projects. Future courses are encouraged to allocate sufficient time for practice and exploration. At the same time, further research could expand the sample size and examine the effects of such courses on computational thinking development.},
  keywords={Art;Education;Anxiety disorders;Animation;Information technology;Programming profession;Programming;STEAM;Art;Gender Difference},
  doi={10.1109/ITET65804.2025.11100911},
  ISSN={},
  month={May},}

@INPROCEEDINGS{10565656,
  author={García, Alfredo and Gonzalez, Juan Manuel and Guerrero, Josefina},
  booktitle={2023 XIII International Conference on Virtual Campus (JICV)}, 
  title={Application of the STEM Methodology in the Development of a Closed-Loop Control System}, 
  year={2023},
  volume={},
  number={},
  pages={1-4},
  abstract={The STEM methodology has been applied in different study approaches, covering different areas such as arts, internet of things, computational thinking, among others. In this paper, two necessary approaches are addressed for the implementation of a closed-loop control system. The first approach (programming) is directly related to the software implementation and the second approach addresses the hardware instrumentation part. Both approaches are developed in a practical teaching case, from a STEM Maker workshop which consisted of 15 sessions with duration 2 hours each one. Each session consisted of 4 stages: Stage 1 (Theoretical concepts), Stage 2 (Practical Example), Stage 3 (Practice) and Stage 4 (challenge). Through these four stages, the development of skills of the attendees in the areas of programming and electronics was encouraged, applying the STEM Maker strategy. From some evaluation instruments, data was collected about the development of skills of the assistants in the implementation of software and hardware instrumentation, acquired in the STEM Maker workshop. The results indicated that approximately 70% of the workshop attendees developed the necessary skills to propose solutions to problems in their current context where the application of programming and/or electronics intervenes. The product obtained from the practice is described as a temperature control which integrates a feedback signal, this system has a wide field of applications which allowed the students of the STEM Maker workshop to achieve a project related to the individual context of each one.},
  keywords={Conferences;Instruments;Education;Collaboration;Programming;Software;Hardware;STEM Methodology;closed-loop;control;Maker movement;learning approach},
  doi={10.1109/JICV59748.2023.10565656},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{11428537,
  author={Boonsongsrikul, Anuparp and Wattanamongkhol, Norrarat},
  booktitle={2025 2nd International Conference on Innovations in Engineering, Science and Technology for Sustainable Development (ICEST)}, 
  title={PBL-CDIO: Design and Implementation of a Zerocarbon Robot Car for Stem Education}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Modern STEM education faces the dual challenge of preparing students with advanced practical skills for a rapidly evolving technological landscape while simultaneously addressing persistent educational inequalities. This paper proposes a learning management model that combines ProblemBased Learning (PBL) with the CDIO (Conceive, Design, Implement, Operate) framework to design and build carbonfree robot cars. The study explores the impact of this integrated model on student participation, computational thinking, teamwork, creativity, and STEM proficiency. A sample of 131 high school students from five Thai schools participated. The model includes four stages: 1) Problem awareness and goal setting, 2) Design and planning, 3) Building and programming, and 4) Implementation. The learning outcomes were assessed using a 4-choice test aligned with Bloom's Taxonomy. Results showed significant improvement in student skills, with posttraining scores rising from 2.5-3.5 to 4.0-4.5 ($\mathbf{p}<0.05$). Teams that completed tasks, such as controlling robot movement, received high satisfaction ratings (average $=4.3$). The model significantly enhanced students' robot control and engineering thinking, demonstrating its effectiveness in promoting digitalage education.},
  keywords={Training;Technological innovation;Computational modeling;Education;Taxonomy;Autonomous automobiles;Teamwork;Sustainable development;Creativity;STEM;STEM;PBL;CDIO;Education Robot;SDG 4},
  doi={10.1109/ICEST65883.2025.11428537},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{9620583,
  author={Delacoudray, Chalece A. and Newton, Sunni H. and Alemdar, Meltem and Grossman, Sabrina and Garrett, Stephen and Freeman, Jason and Wilson, Joycelyn and Barbot, Hilah and Moore, Roxanne},
  booktitle={2021 Conference on Research in Equitable and Sustained Participation in Engineering, Computing, and Technology (RESPECT)}, 
  title={Your Voice is Power: Integrating Computing, Music, Entrepreneurship, and Social Justice Learning}, 
  year={2021},
  volume={},
  number={},
  pages={1-2},
  abstract={Computational thinking has become pervasive across many technical and creative disciplines. Creating a computationally literate workforce capable of recognizing and eliminating algorithmic discrimination requires diverse perspectives and lived experiences. Diversity within computing is a persistent problem; in 2014, several large tech companies released diversity reports and made commitments to improvement. As of 2020, improvements have been minor, especially for Black employees. Compared to US demographics, the percentage of Black and Latinx students pursuing degrees in computing remains low, even as numbers improve in STEM more broadly. It is more important than ever to prioritize a diverse computing workforce and a computationally literate workforce, more broadly, whose interests reside with equitable outcomes.},
  keywords={Entrepreneurship;Companies},
  doi={10.1109/RESPECT51740.2021.9620583},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11249590,
  author={Oliveira, Clarisse Ribeiro and da Silva Reis, Mariana and Pastrana, M. A. and de Oliveira, Miguel Scardini and Gomes Rocha, Nícolas Yuri and Munoz, Daniel M. and de Souza Baptista, Roberto},
  booktitle={2025 Brazilian Symposium on Robotics (SBR) and 2025 Workshop on Robotics in Education (WRE)}, 
  title={The Impact of the Edubot Project on Students' Entry Into STEM Fields}, 
  year={2025},
  volume={},
  number={},
  pages={443-447},
  abstract={This study examines the impact of the Edubot Project, an educational robotics project created by the University of Brasília IEEE Robotics and Automation Society, on Brazilian student's interest in STEM (Science, Technology, Engineering, and Mathematics) subjects. This study employs a qualitative methodology to examine interviews with two former participants who went on to pursue STEM careers, examining how practical robotics education improved their technical proficiency, and problem-solving capacity. The results show that although the initiative mainly supports STEM-inclined students' future choices, it also greatly enhances their academic readiness by enhancing computational thinking, programming logic, and exposure to college life. The results highlight the potential of robotics-based interventions to bridge educational gaps and inspire future STEM professionals in underprivileged settings.},
  keywords={Mechatronics;Engineering profession;Conferences;Education;Teamwork;Problem-solving;Logic;Robots;Programming profession;STEM;Edubot;Education;Robotics;Social Habilities;Teamwork;High-School;STEM},
  doi={10.1109/SBR/WRE66973.2025.11249590},
  ISSN={2643-685X},
  month={Oct},}

@INPROCEEDINGS{11413351,
  author={Fan, Rui},
  booktitle={2025 International Conference on Educational Technology Management (ICETM)}, 
  title={A CiteSpace-Based Visualization Analysis of Research Hotspots and Evolutionary Trends in Educational Robotics}, 
  year={2025},
  volume={},
  number={},
  pages={639-643},
  abstract={The integration of artificial intelligence and robotics into education has established educational robotics as a critical component of intelligent learning environments. However, the growing body of literature and inherent interdisciplinary complexity have made it increasingly challenging to grasp the field's knowledge structure and evolutionary dynamics. This study conducts a comprehensive bibliometric analysis to map research hotspots, trace developmental pathways, and identify emerging trends within educational robotics. Using CiteSpace v6.4.R1, we examined 281 relevant articles from the Web of Science Core Collection published between January 2012 and August 2025. Through keyword co-occurrence analysis, burst detection, and timezone visualization, three major research themes were identified: computational thinking and STEM skill development, robotics in elementary and childhood education, and educational robot design and technological integration. The evolution of the field was divided into three distinct phases: foundational exploration, pedagogical expansion, and specialization and efficacy. Current research frontiers include AI-robot integration, the evolving role of educators in human - AI collaborative settings, longitudinal impact assessments, and ethical implementation challenges. The study provides a systematic overview of the intellectual landscape of educational robotics, offering valuable insights for future research and practice aimed at fostering technological and pedagogical advancement in the field.},
  keywords={Visualization;Ethics;Systematics;Educational robots;Reviews;Bibliometrics;Human-robot interaction;Learning (artificial intelligence);Market research;Trajectory;educational robotics;bibliometric analysis;research hotspots;evolutionary trends;CiteSpace},
  doi={10.1109/ICETM67477.2025.11413351},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{11193596,
  author={Yan, Zhihao and Huang, Rong and Chen, Jiaxin and Jiang, Yiyangtong and Xiong, Qingquan and Yang, Lihao},
  booktitle={2025 International Conference on Distance Education and Learning (ICDEL)}, 
