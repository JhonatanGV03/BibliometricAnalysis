@INPROCEEDINGS{11387041,
  author={Richard, Gabriela T. and Xu, Yanping and Faimon, Lillyanna and Weible, Jennifer L. and Zimmerman, Heather Toomey},
  booktitle={2025 International Conference on Education Technology and Computers (ICETC)}, 
  title={Exploring Diverse Youth’s Computational Literacy and Learning Through Interdisciplinary, Multimodal and IoT Computing and Game Making Out-of-School Learning Activities}, 
  year={2025},
  volume={},
  number={},
  pages={733-739},
  abstract={This paper reports on preliminary findings from a design-based research project, which includes a collaborative, research-practice partnership that builds upon prior efforts to understand and support youth’s STEM engagement, curiosity and computational thinking through learner-centered, interdisciplinary computing and engineering activities. Primary participants ($\mathbf{n} \boldsymbol{=} \mathbf{4 9}$) were secondary school-aged youth (aged 14-18) with little to no prior computer science and engineering educational experience, who participated in Upward Bound, a federal program for youth from low-income families where they would be the first to attend college. Youth participants engaged in 1-week summer workshops centered on interdisciplinary computational science and engineering education as part of summer Upward Bound STEM enrichment activities in two different states (one in the Midwest and one in the mid-Atlantic). We measured changes in their computational thinking qualitatively utilizing interaction analysis of video data captured during the workshop and a validated quantitative measure that holistically captures several aspects of CT self-efficacy (e.g., collaborating, abstracting, developing computational artifacts). Findings include quantitative changes in different aspects of their computational thinking attitudes and perspectives, and a qualitative case study that helps illustrate how and why certain aspects of CT may have been more statistically significant for the diverse rural and urban youth participants. We discuss the trends and complexities in the findings as well as ongoing efforts aimed at improving outcomes in related research and practice.},
  keywords={Shape;Scientific computing;Conferences;Games;Market research;Particle measurements;Complexity theory;Engineering education;STEM;Videos;Computational Thinking;STEM Education;Making;STE(A)M;Computing and Engineering Education;Integrated Systems;Diverse Youth;Inclusive Computing;Mixed Methods;Research-Practice Partnership},
  doi={10.1109/ICETC66579.2025.11387041},
  ISSN={},
  month={Sep.},}

@INPROCEEDINGS{11297622,
  author={dos Santos, João Pedro Silveira and Ferreira, Maria Eduarda Soares and Rocha, Sarah Bueno and de Azambuja, Leticia Domingues and Vargas, Diogo Ribeiro and De Oliveira, Adriano Quilião and Koch, Gustavo Guilherme and Martini, Ricardo Giuliani},
  booktitle={2025 17th Seminar on Power Electronics and Control (SEPOC)}, 
  title={Bridging the High School-Elementary Education Gap in Logical Thinking and Programming}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Teaching Computational in schools is an essential approach for integrating computational and technological knowledge into society, sparking students' interest in learning. This article outlines the structure of a proposed analysis of teaching methodologies and the significance of computational thinking in the context of Computational education. The study will be conducted throughout the second semester of 2025. Through the implementation of qualitative activities, two 9thgrade classes, one from a municipal school and the other from a state school, will be compared. In one institution, computational thinking will be taught prior to programming lessons, while in the other, students will be introduced directly to programming content. Based on evaluative activities, the research team aims to assess the relevance of teaching computational thinking before programming and its potential impacts on the learning process.},
  keywords={Seminars;Electric potential;Education;Educational technology;Power electronics;Programming profession;Programming Education;Computational Thinking;Teaching Methodologies;Learning Assessment;Basic Education;Educational Technology},
