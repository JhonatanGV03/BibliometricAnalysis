@INPROCEEDINGS{10130181,
  author={Tabassum, Shawana and Sundaravadivel, Prabha},
  booktitle={2023 IEEE 16th Dallas Circuits and Systems Conference (DCAS)}, 
  title={Blending Entrepreneurial Education in Senior and Graduate-level Electrical Engineering Courses}, 
  year={2023},
