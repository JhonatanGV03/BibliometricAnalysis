@INPROCEEDINGS{10386409,
  author={Villanueva-Miranda, Ismael and Mortimer, Katherine and Akbar, Monika and Reyes, Romelia Rodriguez and Ontiveros, Cynthia and Gray, Scott and Delgado, Pedro and Medrano, Victor and Anderson, Melissa and Ramirez, Jacob and Vazquez, Jesus},
  booktitle={2023 IEEE International Conference on Big Data (BigData)}, 
  title={Introducing Computational Thinking in Middle-Schools using a Culturally-responsive Game through a Researcher-Practitioner Partnership}, 
