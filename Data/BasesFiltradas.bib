@INPROCEEDINGS{11420327,
  author={Contreras, Marcela Varas and Jerez, Contanza Molina and Flores-Oyarzo, Gabriela},
  booktitle={2025 44th International Conference of the Chilean Computer Science Society (SCCC)}, 
  title={Apprentice Level Training Program for Teaching Basic Knowledge and Skills for Computational Thinking and Programming}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={The current work environment has undergone rapid transformation thanks to the growing use of digital technologies and artificial intelligence, demanding new professional skills. Thus, Computational Thinking and Programming has become a key competency for adapting, innovating, and adding value in professional work, where Higher Education Institutions (HEI) play a fundamental role. In response to this, the University of Concepción has created a training program to develop Computational Thinking and Programming (CT&P). This article presents the characteristics and results of the piloting of the Apprentice Level module of this program, which consists of specific skills, learning outcomes, and achievement indicators that allowed participants to be certified. In addition, a diagnostic tool was validated to determine each student's learning path. As a result, the diagnostic tool reported adequate levels of reliability (KR = .82 points) and a 4-factor structure, allowing 86 students to be certified with CT&P Apprentice Level competency. Meanwhile, 616 students enrolled in the pilot module, of which 22.72% received full certification and 77.27% received partial certification in the competency. The development of digital competencies in HEI is highly relevant in the context of training professionals with the skills to anticipate and respond to the needs of the current labor market. Thus, the results of this pilot program are highly valuable in that they allow for the adjustment of training processes for the development of CT&P and constitute an input for the development of this competency in other educational environments.},
  keywords={Reliability;Artificial intelligence;Programming profession;Certification;Computational Thinking;Programming;Higher Education;Professional Development;Digital Skills},
  doi={10.1109/SCCC67219.2025.11420327},
  ISSN={2691-0632},
  month={Oct},}

@INPROCEEDINGS{11092078,
  author={Zhang, Zhe and Yi, Jingwen and Xiong, Dan and Sheng, Yuxia},
  booktitle={2025 7th International Conference on Computer Science and Technologies in Education (CSTE)}, 
  title={Cultivation of Computational Thinking in University Students through STEM Education: A Case Study of Digital Signal Processing}, 
