  booktitle={2021 7th International Conference of the Immersive Learning Research Network (iLRN)}, 
  title={Logibot: Investigating Engagement and Development of Computational Thinking Through Virtual Reality}, 
  year={2021},
  volume={},
  number={},
  pages={1-5},
  abstract={In this study we assess the effects of teaching fundamental programming concepts through a virtual reality (VR) block-based programming application and its impact on engagement. As a comparison study, participants played an existing desktop-based game (LightBot) and the developed VR game (LogiBot) covering similar gameplay mechanics and block-based programming. Initial results indicate that traditional desktop applications are currently more engaging than VR for teaching programming. We thus identify the need for careful design of interaction methods to support ease of use and reward factors to promote engagement in VR-based learning applications beyond the initial wow-factor.},
  keywords={Design methodology;Education;Games;Virtual reality;Programming;Tools;virtual reality;engagement;education;visual programming},
  doi={10.23919/iLRN52045.2021.9459352},
  ISSN={},
