@INPROCEEDINGS{9155751,
  author={Barron-Estrada, Maria Lucia and Zatarain-Cabada, Ramon and Cardenas-Sainz, Brandon Antonio},
  booktitle={2020 IEEE 20th International Conference on Advanced Learning Technologies (ICALT)}, 
